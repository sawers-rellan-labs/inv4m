// Nextflow config for PSU2022 kallisto quantification
// Adapted from maizeRNA repository

env {
    NXF_OFFLINE = 'true'
    NXF_ANSI_LOG = 'false'
}

manifest {
    nextflowVersion = '!>=21.04.0'
    defaultBranch = 'main'
}

// Offline mode settings
offline = true
workDir = './work'

// Disable features that require internet
tower {
    enabled = false
}

params {
    // === PSU2022 Dataset ===
    // FASTQ files location (paired-end, expecting *_1.fastq.gz and *_2.fastq.gz)
    // Uses existing symlink: PSU2022/data -> ../../RNAseq/RellanAlvarez/
    seq_dir = '/rsstu/users/r/rrellan/DOE_CAREER/inv4m/PSU2022/data'

    // Reference transcriptome for kallisto
    ref_transcriptome = '/rsstu/users/r/rrellan/sara/ref/Zea_mays.Zm-B73-REFERENCE-NAM-5.0.cdna.all.fa'

    // Output directory - relative to run location (PSU2022/kallisto/)
    outdir = './quant_out'
}

profiles {
    lsf {
        process {
            executor = 'lsf'
            queue = 'sara'
            conda = '/share/maize/frodrig4/conda/env/kallisto'
        }
    }
}

process {
    // Default resources
    cpus = 1
    memory = '4.GB'
    time = '1h'

    // Resources for Quantification Processes
    withName: 'INDEX_TRANSCRIPTOME_KALLISTO' {
        cpus = 1  // kallisto index is single-threaded
        memory = '16.GB'
        time = '1h'
    }
    withName: 'QUANT_KALLISTO' {
        cpus = 4  // kallisto quant supports multi-threading
        memory = '2.GB'
        time = '1h'
    }
}

conda {
    enabled = true
}

// Reporting
timeline.enabled = true
report.enabled = true
dag.overwrite = true
