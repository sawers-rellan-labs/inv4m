// Nextflow config for PSU2022 kallisto quantification with JMJ-corrected cDNA
// Uses corrected reference that separates 4 JMJ paralogs

manifest {
    nextflowVersion = '!>=21.04.0'
    defaultBranch = 'main'
}

params {
    // FASTQ files location
    seq_dir = '/rsstu/users/r/rrellan/DOE_CAREER/inv4m/PSU2022/data'

    // JMJ-CORRECTED reference transcriptome
    ref_transcriptome = '/rsstu/users/r/rrellan/DOE_CAREER/inv4m/PSU2022/ref/Zea_mays.Zm-B73-REFERENCE-NAM-5.0.cdna.jmj_corrected.fa'

    // Output directory - separate from original run
    outdir = './quant_out_jmj_corrected'
}

profiles {
    lsf {
        process {
            executor = 'lsf'
            queue = 'sara'
            beforeScript = 'source ~/.bashrc && conda activate /share/maize/frodrig4/conda/env/kallisto'
        }
    }
}

process {
    cpus = 1
    memory = '4 GB'
    time = '1h'

    withName: 'INDEX_TRANSCRIPTOME_KALLISTO' {
        cpus = 1
        memory = '16 GB'
        time = '1h'
    }
    withName: 'QUANT_KALLISTO' {
        cpus = 4
        memory = '4 GB'
        time = '1h'
    }
}

// Reporting
timeline.enabled = true
report.enabled = true
